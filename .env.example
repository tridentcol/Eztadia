# Eztadia · environment variables
#
# Copia este archivo a `.env.local` y rellena los valores reales.
# `.env.local` NO se commitea (esta en .gitignore via ".env*.local").
# Mantener este archivo actualizado cuando se agreguen nuevas vars.

# ─────────────────────────────────────────────────────────────────────────────
# Supabase · Phase B1
# ─────────────────────────────────────────────────────────────────────────────

# URL publica del proyecto Supabase (formato https://<ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Anon key (JWT legacy) — segura para cliente, RLS la filtra
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SENSIBLE. Solo en lib/supabase/admin.ts (server-only).
# NUNCA exponer al cliente. NO commitear.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection strings
# DATABASE_URL: via pgbouncer (puerto 6543) — uso runtime de Prisma
# DIRECT_URL: conexion directa (puerto 5432) — uso migrations de Prisma
DATABASE_URL=
DIRECT_URL=

# ─────────────────────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────────────────────

# URL base de la app — usada para links absolutos (emails, redirects OAuth)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# A agregar en fases posteriores (placeholders, no usar todavia)
# ─────────────────────────────────────────────────────────────────────────────

# Phase B · cifrado de secrets en DB (Wompi key, WhatsApp token)
ENCRYPTION_KEY=  # 64 hex chars = 32 bytes (openssl rand -hex 32)

# Phase B14 · cron endpoints
CRON_SECRET=  # 32+ chars random (openssl rand -hex 32)

# Phase E4 · email (Resend)
# Crear cuenta en https://resend.com — free 3000/mes, 100/dia
# Sandbox: usar RESEND_FROM_EMAIL=onboarding@resend.dev (solo envia al email
# owner de la cuenta Resend). Para produccion: verificar dominio y usar
# noreply@<tu-dominio>.com.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Eztadia <onboarding@resend.dev>

# Phase E5 · Turnstile (anti-bot en forms publicos)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Phase F · rate limit + observabilidad
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# NEXT_PUBLIC_SENTRY_DSN=

# WhatsApp Cloud API (Meta)
# META_APP_SECRET=
# META_VERIFY_TOKEN=
